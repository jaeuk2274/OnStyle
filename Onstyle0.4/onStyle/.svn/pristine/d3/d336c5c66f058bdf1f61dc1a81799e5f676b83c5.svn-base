                      <font style="font-size:small;color:red;">*</font>
                  </th>
                  <td>
                     <input type="text" style="border: 1px solid #BDBDBD;width:250px;">
                  </td>
               </tr>
               <tr>
                  <th>
                     비밀번호 확인
                      <font style="font-size:small;color:red;">*</font>
                  </th>
                  <td>
                     <input type="text" style="border: 1px solid #BDBDBD;width:250px;">
                  </td>
               </tr>
               <tr>
                  <th>
                     휴대전화
                      <font style="font-size:small;color:red;">*</font>
                  </th>
                  <td>
                     <select style="border: 1px solid #BDBDBD;height:30px; width:80px;">
                     <option value="010" selected>010</option>               
                     <option value="011">011</option>
                     <option value="016">016</option>             
                     <option value="017">017</option>
                     <option value="018">018t</option>
                     <option value="019">019</option>                  
                  </select>
                     -
                     <input type="text" style="border: 1px solid #BDBDBD; width:150px;">
                     -
                     <input type="text" style="border: 1px solid #BDBDBD; width:150px;">
                  </td>
               </tr>
               <tr>
                  <th>
                     주소
                      <font style="font-size:small;color:red;">*</font>
                  </th>
                  <td>
                     <input type="text" style="border: 1px solid #BDBDBD;width:200px;">-
                      <button type="button" class="btn btn-default btn-sm" onclick="javascript:sample6_execDaumPostcode();">우편번호></button>
                     <br></br>
                     <input type="text"style="border: 1px solid #BDBDBD;width:350px;">기본주소
                     <br></br>
                     <input type="text"style="border: 1px solid #BDBDBD;width:350px;">나머지 주소
                  </td>
               </tr>
               <tr>
                  <th>
                     생년월일
                      <font style="font-size:small;color:red;">*</font>
                  </th>
                  <td>
                     <input type="text"style="border: 1px solid #BDBDBD; width:100px;">년
                     <input type="text"style="border: 1px solid #BDBDBD;width:70px;">월
                     <input type="text"style="border: 1px solid #BDBDBD;width:70px;">일
                  </td>
               </tr>
               <tr>
                  <th>
                     이메일
                      <font style="font-size:small;color:red;">*</font>
                  </th>
                  <td>
                     <input type="text"style="border: 1px solid #BDBDBD;">
                     @
                     <input type="text"style="border: 1px solid #BDBDBD; width:">
                     <select style="border: 1px solid #BDBDBD;height:30px; width:130px;">
                     <option value="이메일선택" selected>-이메일 선텍-</option>               
                     <option value="naver.com">naver.com</option>
                     <option value="daum.net">daum.net</option>             
                     <option value="nate.com">nate.com</option>
