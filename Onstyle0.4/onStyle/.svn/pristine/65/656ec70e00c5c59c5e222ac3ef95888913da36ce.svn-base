		                        </select>
                     <!--준분류 -->	                     
		                        <select id="midCategory" name="midCategory" class="form-control" style="width:30%;">
		                        </select>
		                    </td>
		        		</tr>
		        		<tr>
		        			<th class="active text-center" style="vertical-align:middle">
		        				진열 상태
