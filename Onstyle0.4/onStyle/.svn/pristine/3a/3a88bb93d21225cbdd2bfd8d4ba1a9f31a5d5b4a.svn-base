function deleteCodi(codiseq){
   var wheather = confirm("코디를 삭제하시겠습니까?");
   if(wheather==true){
      window.location.href = "/deleteCodi.do?selectedCodiSeq="+codiseq+"&location=1";
   } else{
      return;
   }
}

function shareCodi(codiseq){
   var wheather = confirm("코디를 공유하시겠습니까?");
   if(wheather==true){
      window.location.href = "/shrCodi.do?selectedCodiSeq="+codiseq+"&location=1";
   } else{
      return;
   }
}

function prodct_read(prodct_seq){
	alert("상품seq가 "+prodct_seq+" 인 상품조회");
}
