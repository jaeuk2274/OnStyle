<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
    <%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c"%>
 
<!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN" "http://www.w3.org/TR/html4/loose.dtd">
<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
<title>코디공유게시판</title>

<!-- consmrMenu css, js 링크 모아 놓은곳 -->
<%@ include file="/WEB-INF/include/include-header.jspf" %>   

<script>
function aring(ar){
	window.location.href="/codiShr.do?codi_shr_order="+ar;
}
function myCodi(seq){
	window.location.href="/codiShr.do?mem_seq="+seq;
}
</script>

</head>
<body>
   <div>
      <c:import url="/menu.do"/>
   </div>

   <!-- 본인 디자인은 여기 안에서 -->
   <div class="mainContainer" style=" height:100%;">
   
      <div class="container" style="height:75%; width:100%;">
<!--       정렬 메뉴 -->
         <div style="float:right; width:100%;">
            <div class="bs-component" style="float:right;">
               <ul class="nav nav-tabs">
                  <li onclick="javascript:aring('s.codi_shr_regtime')"><a href="#home" data-toggle="tab">NEW</a></li>
                  <li onclick="javascript:aring('liked desc')"><a href="#profile" data-toggle="tab">HOT</a></li>
                  <li onclick="javascript:myCodi()"><a href="#profile" data-toggle="tab">MY CODI</a></li>
               </ul>
            </div>
         </div>

         <div style="height:15%; margin:0 auto; padding-top:3%;">
            <h5><center>BEST CODI</center></h5>
         </div>
         
<!--     베스트 코디 -->
         <div class="row"">
            <c:import url="/bestCodiShr.do"/>      
         </div>
         
         <div style="margin:0 auto; padding-top:3%;">
            <h5><center>NEW</center></h5>
         </div>
         
<!--     코디 목록들 -->
         <div class="row" style="height:500px; margin-top:30px;">
            <c:import url="/codiShrList.do"/>       
         </div>
      </div>
      
   </div>

</body>
</html>