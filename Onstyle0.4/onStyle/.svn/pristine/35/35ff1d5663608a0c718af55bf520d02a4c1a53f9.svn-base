<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8"%>
<!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN" "http://www.w3.org/TR/html4/loose.dtd">
<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
<title>Insert title here</title>
<script type="text/javascript">
	function insert_goal_popup() {
		var popUrl = "insert_goal_popup.do";//팝업창에 출력될 페이지 URL
		var popupName= "goalpopup";
		var width = 400;
		var height = 200;
		var leftPosition = (screen.width/2) - (width/2);
		leftPosition += window.screenLeft;//듀얼 모니터일때
		var topPosition = (screen.height/2) - (height/2);
		var popOption;
		
		var win = window.open(popUrl, popupName, "left="+leftPosition+",top="+topPosition+",width="+width+",height="+height+", toolbars=no, resizable=no, scrollbars=no");
		
		document.frm.target = popupName;
		document.frm.action = "/insert_goal_popup.do";
		document.frm.submit();

		if(win == null) {//만약 팝업 차단으로 팝업창이 나타나지 않을 경우
			alert("팝업차단을 해제해주세요!");
		}
		else {
			win.focus();
		}
	}
</script>
</head>
<body>

</body>
</html>